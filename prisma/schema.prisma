  aitesaki_address2     String?
  aitesaki_address3     String?
  aitesaki_yubin_no     String?
  aitesaki_tel_no       String?
  tantosya_cd           String?
  tiiki_cd              String?
  gyosyu_cd             String?
  best_juni             String?
  kyakusaki_bunrui      String?
  gaityu_bunrui         String?
  nokyo_kbn             String?
  sime_date             String?
  zei_kbn               String?
  aitesaki_kbn          String?
  hon_kari_kbn          String?
  president             String?
