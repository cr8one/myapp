  @@map("prinser_m_tokui_nonyu")
}

model DeviceModel {
  modelId       Int       @id @default(autoincrement()) @map("model_id")
  vendorName    String?   @map("vendor_name")
  deviceType    String?   @map("device_type")
  modelName     String    @map("model_name")
  modelNumber   String?   @map("model_number")
  osName        String?   @map("os_name")
  cpuInfo       String?   @map("cpu_info")
  memoryDefault String?   @map("memory_default")
  storageDefault String?  @map("storage_default")
  eolDate       DateTime? @map("eol_date")
  imagePath     String?   @map("image_path")
  note          String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  @@map("m_device_models")
}

model Vendor {
  id        Int      @id @default(autoincrement())
  name      String
  flgDel    Boolean  @default(false) @map("flg_del")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("m_vendors")
}


model TerminalMaster {
