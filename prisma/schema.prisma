generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
enum Role {
  ADMIN
  USER
}
model User {
  id          String                 @id @default(cuid())
  email       String                 @unique
  password    String
  name        String?
  departments UserDepartment[]
  groups      UserGroup[]
  position    String?
  phone       String?
  employeeNo  String?  @map("employee_no")
  gender      String?
  employmentType String? @map("employment_type")
  role        Role                   @default(USER)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  dppMember   Boolean                @default(false) @map("dpp_member")
  shortName   String?                @map("short_name")
  products    Product[]
  exhibitions DevExhibitionVisitor[]
  permission  UserPermission?
  assignedProjects DevProjectAssignee[]
  suppliesAsIssuer            SealSupply[] @relation("SealIssuer")
  suppliesAsSupplier          SealSupply[] @relation("SealSupplier")
  suppliesAsReceiver          SealSupply[] @relation("SealReceiver")
  suppliesAsOutsourceReceiver SealSupply[] @relation("SealOutsourceReceiver")
  suppliesAsSalesPerson       SealSupply[] @relation("SealSalesPerson")
  devLogs                     DevLog[]
  announcements               Announcement[]
  loginLogs                   LoginLog[]
  auditLogs                   AuditLog[]
  cadRequests                 CadRequest[]
  addressBookChangeRequests    AddressBookChangeRequest[]
}
model UserPermission {
  id            String   @id @default(cuid())
  userId        String   @unique @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specView      Boolean  @default(true)  @map("spec_view")
  specEdit      Boolean  @default(false) @map("spec_edit")
  estimateView  Boolean  @default(true)  @map("estimate_view")
  estimateEdit  Boolean  @default(false) @map("estimate_edit")
  eappView      Boolean  @default(true)  @map("eapp_view")
  eappEdit      Boolean  @default(false) @map("eapp_edit")
  travelView    Boolean  @default(true)  @map("travel_view")
  travelEdit    Boolean  @default(false) @map("travel_edit")
  sopView       Boolean  @default(true)  @map("sop_view")
  sopEdit       Boolean  @default(false) @map("sop_edit")
  reportView    Boolean  @default(true)  @map("report_view")
  reportEdit    Boolean  @default(false) @map("report_edit")
  bpmsView      Boolean  @default(true)  @map("bpms_view")
  bpmsEdit      Boolean  @default(false) @map("bpms_edit")
  dlmsView      Boolean  @default(true)  @map("dlms_view")
  dlmsEdit      Boolean  @default(false) @map("dlms_edit")
  dppView       Boolean  @default(true)  @map("dpp_view")
  dppEdit       Boolean  @default(false) @map("dpp_edit")
  ssssView      Boolean  @default(true)  @map("ssss_view")
  terminalView  Boolean  @default(false) @map("terminal_view")
  ssssEdit      Boolean  @default(false) @map("ssss_edit")
  mastersView   Boolean  @default(false) @map("masters_view")
  mastersEdit   Boolean  @default(false) @map("masters_edit")
  cadView       Boolean  @default(true)  @map("cad_view")
  cadEdit       Boolean  @default(false) @map("cad_edit")
  ssssIsIssuer            Boolean @default(false) @map("ssss_is_issuer")
  ssssIsSupplier          Boolean @default(false) @map("ssss_is_supplier")
  ssssIsReceiver          Boolean @default(false) @map("ssss_is_receiver")
  ssssIsOutsourceReceiver Boolean @default(false) @map("ssss_is_outsource_receiver")
  ssssIssuerOrder            Int @default(0) @map("ssss_issuer_order")
  ssssSupplierOrder          Int @default(0) @map("ssss_supplier_order")
  ssssReceiverOrder          Int @default(0) @map("ssss_receiver_order")
  ssssOutsourceReceiverOrder Int @default(0) @map("ssss_outsource_receiver_order")
  addressBookView              Boolean @default(true)  @map("address_book_view")
  addressBookEdit              Boolean @default(false) @map("address_book_edit")
  addressBookChangeRequestTarget Boolean @default(false) @map("address_book_change_request_target")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt      @map("updated_at")
  @@map("user_permissions")
}
model Product {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  parts       Part[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
model Part {
  id        String   @id @default(cuid())
  code      String
  name      String
  note      String?
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model DevCompany {
  id              String                 @id @default(cuid())
  name            String
  nameKana        String?
  industry        String?
  status          String                 @default("登録のみ")
  postalCode      String?                @map("postal_code")
  address         String?
  phone           String?
  url             String?
  notes           String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  primaryProjects DevProject[]           @relation("DevPrimaryCompany")
  projects        DevProjectCompany[]
  exhibitions     DevExhibitionContact[]
  contacts        DevCompanyContact[]
  types           DevCompanyType[]
  @@map("dev_companies")
}
model DevProject {
  id                String              @id @default(cuid())
  title             String
  status            String              @default("商談中")
  description       String?
  expectedOrderDate DateTime?
  notes             String?
  estimatedAmount   Int?     @map("estimated_amount")
  orderedAmount     Int?     @map("ordered_amount")
  primaryCompanyId  String?
  primaryCompany    DevCompany?         @relation("DevPrimaryCompany", fields: [primaryCompanyId], references: [id])
  companies         DevProjectCompany[]
  assignees         DevProjectAssignee[]
  files             DevProjectFile[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  @@map("dev_projects")
}
model DevProjectCompany {
  id        String     @id @default(cuid())
  projectId String
  companyId String
  role      String?
  project   DevProject @relation(fields: [projectId], references: [id])
  company   DevCompany @relation(fields: [companyId], references: [id])
  createdAt DateTime   @default(now())
  @@unique([projectId, companyId])
  @@map("dev_project_companies")
}
model DevExhibition {
  id          String                 @id @default(cuid())
  name        String
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  notes       String?
  summary     String?
  description String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  visitors    DevExhibitionVisitor[]
  contacts    DevExhibitionContact[]
  @@map("dev_exhibitions")
}
model DevExhibitionVisitor {
  id           String        @id @default(cuid())
  exhibitionId String        @map("exhibition_id")
  userId       String        @map("user_id")
  impression   String?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  exhibition   DevExhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id])
  @@unique([exhibitionId, userId])
  @@map("dev_exhibition_visitors")
}
model DevExhibitionContact {
  id           String             @id @default(cuid())
  exhibitionId String             @map("exhibition_id")
  companyId    String             @map("company_id")
  contactId    String?            @map("contact_id")
  notes        String?
  createdAt    DateTime           @default(now()) @map("created_at")
  exhibition   DevExhibition      @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  company      DevCompany         @relation(fields: [companyId], references: [id])
  contact      DevCompanyContact? @relation(fields: [contactId], references: [id])
  @@map("dev_exhibition_contacts")
}
model DevCompanyContact {
  id                 String                @id @default(cuid())
  companyId          String                @map("company_id")
  company            DevCompany            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name               String
  nameKana           String?               @map("name_kana")
  email              String?
  phone              String?
  department         String?
  position           String?
  isPrimary          Boolean               @default(false) @map("is_primary")
  notes              String?
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  exhibitionContacts DevExhibitionContact[]
  @@map("dev_company_contacts")
}
model DevCompanyTypeMaster {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  sortOrder   Int              @default(0) @map("sort_order")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  companies   DevCompanyType[]
  @@map("dev_company_type_masters")
}
model DevCompanyType {
  id           String               @id @default(cuid())
  companyId    String               @map("company_id")
  typeMasterId String               @map("type_master_id")
  company      DevCompany           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  typeMaster   DevCompanyTypeMaster @relation(fields: [typeMasterId], references: [id], onDelete: Cascade)
  createdAt    DateTime             @default(now()) @map("created_at")
  @@unique([companyId, typeMasterId])
  @@map("dev_company_types")
}
model DevProjectAssignee {
  id        String     @id @default(cuid())
  projectId String     @map("project_id")
  userId    String     @map("user_id")
  role      String?
  project   DevProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id])
  createdAt DateTime   @default(now()) @map("created_at")
  @@unique([projectId, userId])
  @@map("dev_project_assignees")
}
model DevProjectFile {
  id        String     @id @default(cuid())
  projectId String     @map("project_id")
  project   DevProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName  String     @map("file_name")
  fileKey   String     @map("file_key")
  fileSize  Int        @map("file_size")
  mimeType  String     @map("mime_type")
  comment   String?
  createdAt DateTime   @default(now()) @map("created_at")
  createdBy String?    @map("created_by")
  @@map("dev_project_files")
}
model SealSerialConfig {
  id        Int      @id @default(autoincrement())
  nextValue Int      @default(3201)
  increment Int      @default(1)
  prefix    String?
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("seal_serial_configs")
}
model SealSupplyCompany {
  id        Int          @id @default(autoincrement())
  name      String       @unique
  sortOrder Int          @default(0) @map("sort_order")
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  supplies  SealSupply[]
  @@map("seal_supply_companies")
}
model SealSupplyPartMaster {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("seal_supply_part_masters")
}
model SealSupply {
  id           Int      @id @default(autoincrement())
  serialCode   String   @unique @map("serial_code")
  isHold       Boolean  @default(false) @map("is_hold")
  holdDeadline DateTime? @map("hold_deadline")
  issueDate    DateTime @default(now()) @map("issue_date")
  productCode  String   @map("product_code")
  orderNo      String   @map("order_no")
  partName     String   @map("part_name")
  qtyShizuokaToTokyo   Int @default(0) @map("qty_shizuoka_to_tokyo")
  qtyTokyoToOutsource  Int @default(0) @map("qty_tokyo_to_outsource")
  qtyTokyoStock        Int @default(0) @map("qty_tokyo_stock")
  companyId   Int?    @map("company_id")
  company     SealSupplyCompany? @relation(fields: [companyId], references: [id])
  companyName String? @map("company_name")
  issuerId   String? @map("issuer_id")
  issuer     User?   @relation("SealIssuer", fields: [issuerId], references: [id])
  issuerName String? @map("issuer_name")
  supplierId   String? @map("supplier_id")
  supplier     User?   @relation("SealSupplier", fields: [supplierId], references: [id])
  supplierName String? @map("supplier_name")
  shipDateFromJS DateTime? @map("ship_date_from_js")
  receiverId   String? @map("receiver_id")
  receiver     User?   @relation("SealReceiver", fields: [receiverId], references: [id])
  receiverName String? @map("receiver_name")
  receiptDateAtSupplier DateTime? @map("receipt_date_at_supplier")
  outsourceReceiverId   String? @map("outsource_receiver_id")
  outsourceReceiver     User?   @relation("SealOutsourceReceiver", fields: [outsourceReceiverId], references: [id])
  outsourceReceiverName String? @map("outsource_receiver_name")
  salesDepartment  String? @map("sales_department")
  salesPersonId    String? @map("sales_person_id")
  salesPerson      User?   @relation("SealSalesPerson", fields: [salesPersonId], references: [id])
  salesPersonName  String? @map("sales_person_name")
  mailSentFlag String   @default("未") @map("mail_sent_flag")
  notes        String?
  department   String?
  pdfExportedAt DateTime? @map("pdf_exported_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("seal_supplies")
}
model DlmsFormatMaster {
  id        Int      @id @default(autoincrement())
  name      String
  width     Float
  height    Float
  unit      String   @default("mm")
  note      String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("dlms_format_masters")
}
model DlmsPartMaster {
  id        Int      @id @default(autoincrement())
  name      String
  width     Float
  height    Float
  shape     String   @default("rect")
  note      String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("dlms_part_masters")
}
model DlmsNoteMaster {
  id         Int      @id @default(autoincrement())
  name       String
  content    String
  fontSize   Int      @default(12) @map("font_size")
  color      String   @default("#1a1a1a")
  fontWeight String   @default("normal") @map("font_weight")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  @@map("dlms_note_masters")
}
model DevLog {
  id          String   @id @default(cuid())
  date        DateTime
  title       String
  content     String
  category    String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@map("dev_logs")
}
model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String
  publishedAt DateTime
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@map("announcements")
}
model LoginLog {
  id         String   @id @default(cuid())
  userId     String?
  email      String
  ipAddress  String?
  userAgent  String?
  status     String
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
  @@map("login_logs")
}
model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  targetModel String
  targetId    String
  targetLabel String?
  diff        String?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])
  @@map("audit_logs")
}
model DlmsDielineParent {
  id            String   @id @default(cuid())
  uid_ntemp     String   @unique
  flg_del       Int      @default(0)
  kyugataban    String?
  genre         String?
  spec          String?
  hinmoku       String?
  dtindt        DateTime @default(now())
  dtupdt        DateTime @updatedAt
  conditions    DlmsDielineCondition[]
  children      DlmsDielineChild[]
  requests      DlmsDielineRequest[]
  drawings      Drawing[]
  parts         DlmsDielinePart[]
  @@map("dlms_dieline_parents")
}
model DlmsDielineCondition {
  id        String             @id @default(cuid())
  parentId  String
  value     String
  sortOrder Int                @default(0)
  parent    DlmsDielineParent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  @@map("dlms_dieline_conditions")
}
model DlmsDielineChild {
  id          String             @id @default(cuid())
  parentId    String
  edaban      String
  han         String?
  me          String?
  kiri        String?
  men         String?
  sizey       Float?
  sizex       Float?
  咥え        Float?
  location    String?
  dxf_filename String?
  flg_del     Int                @default(0)
  dtindt      DateTime           @default(now())
  dtupdt      DateTime           @updatedAt
  parent      DlmsDielineParent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  requests    DlmsDielineRequest[]
  @@map("dlms_dieline_children")
}
model DlmsDielineRequest {
  id                String    @id @default(cuid())
  request_no        String    @unique
  flg_del           Int       @default(0)
  parentId          String
  childId           String?
  shohin_no         String?
  location          String?
  seisan_tanto      String?
  use_date          DateTime?
  use_time          String?
  request_note      String?
  haichi_kakunin_by String?
  haichi_kakunin    String    @default("未手配")
  kansei_date       DateTime?
  kansei_time       String?
  haichi_note       String?
  dtindt            DateTime  @default(now())
  dtupdt            DateTime  @updatedAt
  parent            DlmsDielineParent @relation(fields: [parentId], references: [id])
  child             DlmsDielineChild? @relation(fields: [childId], references: [id])
  @@map("dlms_dieline_requests")
}
model DlmsTypeCondition {
  id           Int      @id @default(autoincrement())
  genre        String?
  spec         String?
  hinmoku      String?
  tag1         String?
  tag2         String?
  genre_sort   Int      @default(0)
  spec_sort    Int      @default(0)
  hinmoku_sort Int      @default(0)
  tag1_sort    Int      @default(0)
  tag2_sort    Int      @default(0)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("m_dlms_type_conditions")
}
model PrinserMUser {
  uid           String   @id
  upass         String?
  unm           String?
  ukana         String?
  kencd         String?
  biko          String?
  ukbn          String?
  ulevel        String?
  listflg       String?
